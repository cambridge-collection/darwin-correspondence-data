    <text>
    <body>
        
        <div type="letter">
            <div type="text">
                <opener>
                    <salute>My dear Old Philos</salute>
                </opener>
                <div type="transcription">
                     
<p>This explains itself. Will you get other signatures as opportunities offer</p>
<p>C. Darwin</p> 
                </div>
            </div>

            
            
        </div>

        

        

        <div type="footnotes">
            <note xml:id="foot.f1">The date is conjectured from the fact that this letter was written on the verso of the <ref target="./DCP-LETT-7886.xml" resp="#mjhawkins">letter from W. E. Darwin, 29 July [1871?]</ref>.</note>
        </div>        
            
    </body>
    </text>
